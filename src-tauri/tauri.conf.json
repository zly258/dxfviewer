{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DXFViewer",
  "version": "1.5.4",
  "identifier": "com.zhangly1403.dxfviewer",
  "build": {
    "frontendDist": "../dxfviewer-example/dist"
  },
  "app": {
    "windows": [
      {
        "title": "DXF Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
