{
  "name": "threejs-dxf-loader",
  "version": "2.0.0",
  "description": "Production-grade 2D & 3D AutoCAD DXF parser and Three.js renderer: ACIS solid reconstruction, hatched fills, full MTEXT inline codes, 100k-entity picking, instant theme switching.",
  "keywords": [
    "threejs",
    "three",
    "dxf",
    "dxf-loader",
    "dxf-viewer",
    "autocad",
    "cad",
    "webgl",
    "2d",
    "3d",
    "acis",
    "hatch",
    "mtext"
  ],
  "homepage": "https://zly258.github.io/dxfviewer/",
  "bugs": {
    "url": "https://github.com/zly258/dxfviewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zly258/dxfviewer.git"
  },
  "license": "MIT",
  "author": {
    "name": "zhangly1403",
    "email": "zhangly1403@qq.com",
    "url": "https://github.com/zhangly1403"
  },
  "main": "./dist/threejs-dxf-loader.umd.js",
  "module": "./dist/threejs-dxf-loader.esm.js",
  "types": "./dist/DXFLoader.d.ts",
  "exports": {
    ".": {
      "types": "./dist/DXFLoader.d.ts",
      "import": "./dist/threejs-dxf-loader.esm.mjs",
      "require": "./dist/threejs-dxf-loader.umd.js",
      "default": "./dist/threejs-dxf-loader.esm.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "types",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "test:renderer": "node scripts/test-renderer.mjs",
    "test:pick": "node scripts/test-pick.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:lang": "node scripts/test-sample-language.mjs",
    "check": "node scripts/test.mjs && node scripts/test-renderer.mjs && node scripts/test-pick.mjs && node scripts/validate-acis-sab.mjs",
    "sync:samples": "node scripts/make-huge-sample.mjs && node scripts/make-showcase.mjs && node scripts/sync-showcase.mjs",
    "prepublishOnly": "npm run build && npm run check"
  },
  "peerDependencies": {
    "three": ">=0.128.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "^1.65.1",
    "three": "^0.180.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
