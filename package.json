{
  "name": "@zhangly1403/dxfviewer",
  "version": "1.5.4",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/dxfviewer.js",
  "module": "./dist/dxfviewer.js",
  "types": "./dist/dxfviewer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dxfviewer.d.ts",
      "import": "./dist/dxfviewer.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "npm --workspace dxfviewer-example run dev",
    "dev:example": "npm run build:lib && npm --workspace dxfviewer-example run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib",
    "build:lib": "npm run typecheck && vite build",
    "build:example": "npm run build:lib && npm --workspace dxfviewer-example run build",
    "build:all": "npm run build:lib && npm --workspace dxfviewer-example run build",
    "preview:example": "npm --workspace dxfviewer-example run preview"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "sideEffects": [
    "./dist/style.css",
    "./src/styles/index.css"
  ],
  "workspaces": [
    "dxfviewer-example"
  ]
}
