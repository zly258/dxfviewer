{
  "name": "@zhangly1403/dxfviewer",
  "version": "1.5.4",
  "author": "zly258 <zhangly1403@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/dxfviewer.js",
  "module": "./dist/dxfviewer.js",
  "types": "./dist/dxfviewer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dxfviewer.d.ts",
      "import": "./dist/dxfviewer.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "import": "./dist/writer.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "npm --workspace dxfviewer-example run dev",
    "dev:example": "npm run build:lib && npm --workspace dxfviewer-example run dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib",
    "build:lib": "npm run typecheck && vite build",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:render": "node scripts/render-smoke.mjs",
    "check:roundtrip": "node scripts/roundtrip.mjs",
    "check:visibility": "node scripts/check-visibility.mjs",
    "check": "npm run build:lib && npm run check:fixtures && npm run check:render && npm run check:visibility && npm run check:roundtrip",
    "convert": "node scripts/dxfviewer-cli.mjs",
    "test:real": "node scripts/real-dxf-test.mjs",
    "build:example": "npm run build:lib && npm --workspace dxfviewer-example run build",
    "build:all": "npm run build:lib && npm --workspace dxfviewer-example run build",
    "preview:example": "npm --workspace dxfviewer-example run preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:example && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "sideEffects": [
    "./dist/style.css",
    "./src/styles/index.css"
  ],
  "workspaces": [
    "dxfviewer-example"
  ]
}
